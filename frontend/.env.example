# Server-only. Never prefix these with NEXT_PUBLIC_, because the API key must not reach the browser.
BACKEND_URL=http://localhost:4000
API_KEY=change-me-to-a-long-random-string

# Accounts (Better Auth)
MONGODB_URI=mongodb://127.0.0.1:27017/howbody_auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
# Set to false only for a standalone local mongod (Atlas supports transactions)
MONGODB_TRANSACTIONS=false

# Optional: Google sign-in (button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: password reset emails via Brevo (printed to the console in dev when unset)
BREVO_API_KEY=
MAIL_FROM=
